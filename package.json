{
  "name": "aicutad-cli",
  "version": "0.5.4",
  "description": "AI coding agent CLI — baca, tulis, edit file & jalankan command otonom. Ditenagai gateway ai.cutad.web.id (OpenAI-compatible /v1).",
  "type": "module",
  "bin": {
    "aicutad": "bin/cutad.mjs"
  },
  "files": [
    "bin/",
    "src/"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "lint": "eslint bin src test",
    "coverage": "node --experimental-test-coverage --test-coverage-lines=55 --test-coverage-functions=50 --test-coverage-branches=50 --test test/*.test.mjs",
    "audit": "npm audit --audit-level=high",
    "sbom": "node scripts/generate-sbom.mjs",
    "check": "npm run lint && npm test && npm run audit"
  },
  "keywords": [
    "cli",
    "ai",
    "agent",
    "coding-agent",
    "coding",
    "openai-compatible",
    "function-calling",
    "tui",
    "terminal",
    "tools",
    "autonomous",
    "cutad"
  ],
  "author": "rudiansyah1998 <rudiansyah1998@users.noreply.github.com>",
  "license": "MIT",
  "homepage": "https://github.com/cutad/aicutad-cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cutad/aicutad-cli.git"
  },
  "bugs": {
    "url": "https://github.com/cutad/aicutad-cli/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "commander": "^12.1.0",
    "picocolors": "^1.1.1",
    "puppeteer": "^25.13.0",
    "undici": "^8.12.2"
  },
  "devDependencies": {
    "eslint": "^10.12.0"
  }
}
